# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Optional: overrides ncbi.email in config.yaml (NCBI Entrez etiquette)
NCBI_EMAIL=
# Optional: raises NCBI rate limit from 3 to 10 req/s
NCBI_API_KEY=
# X API v2 (step 5 only; leave blank until then)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Step 3: nothing posts unless PUBLISH_ENABLED=1 AND run_publish.py --live
PUBLISH_ENABLED=0
# Set to 1 once the account bio discloses AI-assisted drafting (manual step)
BIO_DISCLOSURE_CONFIRMED=0
# Step 2: shared SQLite path and drafting model
DB_PATH=./pipeline.db
DRAFT_MODEL=claude-sonnet-5
# Step 5: ops alerts (all optional; a missing channel is skipped, not an error)
# Generic JSON webhook ({"text": ...}); Slack/Discord/Mattermost incoming webhooks work
ALERT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

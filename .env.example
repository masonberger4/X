# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Optional: "claude_code" runs the Claude Code CLI (logged in with your account)
# instead of the API for scoring and drafting. Overrides config.yaml models.backend.
LLM_BACKEND=api
# Optional: overrides ncbi.email in config.yaml (NCBI Entrez etiquette)
NCBI_EMAIL=
# Optional: raises NCBI rate limit from 3 to 10 req/s
NCBI_API_KEY=
# Step 3: X API v2 user-context keys for posting (leave blank until publishing)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Step 3: nothing posts unless PUBLISH_ENABLED=1 AND run_publish.py --live
PUBLISH_ENABLED=0
# Set to 1 once the account bio discloses AI-assisted drafting (manual step)
BIO_DISCLOSURE_CONFIRMED=0
# Step 2: shared SQLite path and drafting model
DB_PATH=./pipeline.db
# Drafting model override. Leave blank to use config.yaml models.drafter (claude-opus-5).
DRAFT_MODEL=
# Step 4: app-only bearer token for read-only metrics (feedback loop)
X_BEARER_TOKEN=
# Step 5: ops alerts (all optional; a missing channel is skipped, not an error)
# Generic JSON webhook ({"text": ...}); Slack/Discord/Mattermost incoming webhooks work
ALERT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Step 6: sources
# Crossref polite pool contact (overrides crossref.mailto in config.yaml)
CROSSREF_MAILTO=
# Id of the hand-curated X list of oncology KOLs (overrides kol.list_id).
# Reading it uses X_BEARER_TOKEN, which is shared with the step 4 feedback loop.
X_KOL_LIST_ID=
# Step 7: voice
# No new secrets. DRAFT_MODEL above wins over config.yaml models.drafter and
# draft/config.yaml model. Example selection is configured in draft/config.yaml.

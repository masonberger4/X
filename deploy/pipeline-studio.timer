[Unit]
Description=Run the studio three times a day (it starts at most studio/config.yaml's auto.max_new_per_day pieces)

[Timer]
# Ten minutes after the shipped automatic run times, so the morning's stories are scored.
OnCalendar=*-*-* 06,12,18:10:00
RandomizedDelaySec=2min
Persistent=true
Unit=pipeline-studio.service

[Install]
WantedBy=timers.target
